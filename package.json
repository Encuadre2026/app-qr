{
  "name": "app-qr",
  "version": "1.0.0",
  "description": "Aplicación Web Progresiva (PWA) de una sola página diseñada para llevar el control de asistencia del evento **Encuadre 2026**.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "revisar:paquete": "node scripts/revisar-paquete.mjs",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run build && npm run revisar:paquete"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Encuadre2026/app-qr.git"
  },
  "keywords": [
    "encuadre-2026",
    "pwa",
    "qr",
    "control-de-acceso"
  ],
  "author": "Universidad Autónoma de Aguascalientes",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/Encuadre2026/app-qr/issues"
  },
  "homepage": "https://github.com/Encuadre2026/app-qr#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8"
  }
}
